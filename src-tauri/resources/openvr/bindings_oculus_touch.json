{
  "action_manifest_version": 0,
  "bindings": {
    "/actions/calibrate": {
      "sources": [
        { "path": "/user/hand/left/input/grip", "mode": "trigger", "inputs": { "click": { "output": "/actions/calibrate/in/grab" } } },
        { "path": "/user/hand/right/input/grip", "mode": "trigger", "inputs": { "click": { "output": "/actions/calibrate/in/grab" } } },
        { "path": "/user/hand/left/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/calibrate/in/confirm" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/calibrate/in/confirm" } } }
      ]
    }
  },
  "controller_type": "oculus_touch",
  "description": "phone_in_hand calibration",
  "name": "phone_in_hand"
}
